# Example environment settings for Server Inventory Tool.
#
# Copy this file to .env and change the values you need:
#     cp .env.example .env
#
# Python does not read .env files by itself. Load the variables into your
# shell before running the tool:
#     set -a; source .env; set +a
#     python3 main.py
#
# Or set a variable for a single run:
#     INVENTORY_DATA_FILE=test-servers.json python3 main.py --list

# Path to the JSON file that stores the servers (G6).
# Default when unset: servers.json in the project folder.
# A relative path is resolved from the folder you run the command in.
INVENTORY_DATA_FILE=servers.json
